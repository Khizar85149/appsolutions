# Copy this file to .env.local for local work.
# On Vercel, add the same names under Project > Settings > Environment Variables
# (Production, Preview and Development), then redeploy.
#
# None of these start with NEXT_PUBLIC_, on purpose: they stay on the server
# and are never sent to the browser.

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys > Secret key (starts with sb_secret_).
# On older projects this is the "service_role" key. Never share or commit it.
SUPABASE_SECRET_KEY=

# Any long random string. Supabase sends it when content changes so the site
# refreshes at once. Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=

# The live address of the site, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://appssolutionstech.com
